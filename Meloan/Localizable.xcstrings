    "Alert.DeleteAll.Text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to delete all your data? This operation cannot be undone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのデータを削除してもよろしいですか？\n削除後、データは復元できません。"
          }
        }
      }
    },
    "Alert.DeleteAll.Title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete All Data"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのデータを消去"
          }
        }
      }
    },
    "Alert.ResetAllSettings.Text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to reset all your settings? This operation cannot be undone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての設定をリセットしてもよろしいですか？\nリセット後、設定は復元できません。"
          }
        }
      }
    },
    "Alert.ResetAllSettings.Title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset All Settings"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての設定をリセット"
          }
        }
      }
    },
    "Alert.SaveFailed.Message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong while saving this receipt. Please try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシートの保存中に問題が発生しました。もう一度お試しください。"

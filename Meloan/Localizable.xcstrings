            "value": "書き出し形式"
          }
        }
      }
    },
    "Image": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像"
          }
        }
      }
    },
    "PDF": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF"
          }
        }
      }
    },
    "Exports a receipt as an image or a PDF, to send or save. Long receipts are always exported as a PDF.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシートを画像またはPDFとして書き出し、送信や保存ができるようにします。長いレシートは常にPDFで書き出します。"
          }
        }
      }
    },
    "Sharing": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有"
          }
        }
      }
    },
    "Format": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "形式"
          }
        }
      }
    },
    "Get IOU Summary": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "貸し借りの概要を取得"
          }
        }
      }
    },
    "Gets everyone you still have money to settle with: who owes you and whom you owe.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ精算が済んでいない全員を取得します。あなたに借りがある人と、あなたが借りている人です。"
          }
        }
      }
    },
    "%@ owes you %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@さんはあなたに%2$@の借り"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ owes you %2$@"
          }
        }
      }
    },
    "you owe %@ %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたは%1$@さんに%2$@の借り"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "you owe %1$@ %2$@"
          }
        }
      }
    },
    "%@.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。"
          }
        }
      }
    },
    "Get Receipt Text": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシートのテキストを取得"
          }
        }
      }
    },
    "Gets a receipt as plain text, with its items, discounts, taxes and totals, ready to paste into a message.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシートを、項目・割引・税金・合計を含むテキストとして取得します。メッセージにそのまま貼り付けられます。"
          }
        }
      }
    },
    "Get Reminder Message": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "催促メッセージを取得"
          }
        }
      }
    },
    "Gets a friendly message reminding someone what they owe you, the same one the IOU tab shares.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたへの借りを知らせる、やさしい催促メッセージを取得します。貸し借りタブで共有するものと同じです。"
          }
        }
      }
    },
    "There's no tip to add. The total may already be at that amount.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加するチップがありません。合計がすでにその金額になっている可能性があります。"
          }
        }
      }
    },
    "There's nothing to change.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更する内容がありません。"
          }
        }
      }
    },
    "%@ doesn't owe you anything.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@さんはあなたに借りがありません。"
          }
        }
      }

            "value": "支払済"
          }
        }
      }
    },
    "Belongs To": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "担当者"
          }
        }
      }
    },
    "Receipt Item": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシートの項目"
          }
        }
      }
    },
    "Create Receipt": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシートを作成"
          }
        }
      }
    },
    "Creates a new receipt to split. Add items to it afterwards with Add Item to Receipt.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "割り勘する新しいレシートを作成します。項目は「レシートに項目を追加」で追加できます。"
          }
        }
      }
    },
    "Receipts": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシート"
          }
        }
      }
    },
    "What should the receipt be called?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシートの名前は何にしますか？"
          }
        }
      }
    },
    "The person who paid the bill.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会計を支払った人です。"
          }
        }
      }
    },
    "Everyone splitting the receipt, besides the person who paid.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支払人以外で、このレシートを割り勘する人たちです。"
          }
        }
      }
    },
    "Created the receipt %@.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシート「%@」を作成しました。"
          }
        }
      }
    },
    "Add Item to Receipt": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシートに項目を追加"
          }
        }
      }
    },
    "Adds an item to a receipt, either for one person or shared by everyone on it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシートに項目を追加します。一人に割り当てるか、全員で割り勘にできます。"
          }
        }
      }
    },
    "Item Name": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目名"
          }
        }
      }
    },
    "What's the item called?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目の名前は何ですか？"
          }
        }
      }
    },
    "The total price for the item, for all of the quantity.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数量分をすべて含めた、この項目の合計金額です。"
          }
        }
      }
    },
    "How much was it?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いくらでしたか？"
          }
        }
      }
    },
    "For": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "担当者"
          }
        }
      }
    },
    "Who the item is for. Leave empty to share it with everyone on the receipt.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この項目の担当者です。空欄にすると、レシートの全員で割り勘します。"
          }
        }
      }
    },
    "Added %@ to %@.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」を「%2$@」に追加しました。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Added %1$@ to %2$@."
          }
        }
      }
    },
    "Mark Item as Paid": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目を支払済とする"
          }
        }
      }
    },
    "Marks an item on a receipt as paid or unpaid, for everyone or for one person's share.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシートの項目を、全員分または一人分だけ、支払済または未払いにします。"
          }
        }
      }
    },
    "Item": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目"
          }
        }
      }
    },
    "Status": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "状態"
          }
        }
      }
    },
    "paid": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支払済"
          }
        }
      }
    },
    "unpaid": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未払い"
          }
        }
      }
    },
    "Whose share of a shared item to settle. Leave empty to settle it for everyone.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "割り勘の項目で、誰の分を精算するかです。空欄にすると全員分を精算します。"
          }
        }
      }
    },
    "Marked %@ as paid.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」を支払済にしました。"
          }
        }
      }
    },
    "Marked %@ as unpaid.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」を未払いにしました。"
          }
        }
      }
    },
    "Mark Receipt as Paid": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシートを支払済とする"
          }
        }
      }
    },
    "Marks every item on a receipt as paid or unpaid, or just the items one person owes.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシートのすべての項目、または一人が支払うべき項目だけを、支払済または未払いにします。"
          }
        }
      }
    },
    "Settle only what this person owes. Leave empty to settle the whole receipt.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この人が支払うべき分だけを精算します。空欄にするとレシート全体を精算します。"
          }
        }
      }
    },
    "Marked %@'s items on %@ as paid.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
